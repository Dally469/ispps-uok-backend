DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ispps
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_MINUTES=10080
MODEL_ARTIFACT_PATH=ml/artifacts/model.joblib

# URL of the running frontend — used to build links inside emails.
FRONTEND_BASE_URL=http://localhost:3000

# SMTP — leave blank to disable outbound email.
# For Gmail use an App Password (https://myaccount.google.com/apppasswords)
# and put it here WITHOUT spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=ISPPS
SMTP_FROM_EMAIL=
